<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09213c">
    <title><%= locals.weatherData ? `${weatherData.name} Weather | Weatheria` : "Weatheria | Local Weather" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css">
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <a class="brand" href="/" aria-label="Weatheria home">
                <img src="images/icon.png" alt="">
                <span>weatheria</span>
            </a>
            <div class="search-area">
                <form class="search-form" action="/getWeather" method="post" role="search">
                    <label class="visually-hidden" for="city-search">Search a city</label>
                    <input id="city-search" class="city-name" type="search" placeholder="Search a city" name="city" value="<%= locals.searchCity || '' %>" autocomplete="address-level2" required>
                    <button class="submit-btn" type="submit" aria-label="Search weather">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
                        <span>Search</span>
                    </button>
                </form>
                <nav class="recent-searches" aria-label="Recent searches" hidden>
                    <span>RECENT</span>
                    <div class="recent-search-list"></div>
                    <button class="clear-recent" type="button">Clear</button>
                </nav>
            </div>
        </header>

        <main class="main-content">
            <% if(locals.weatherData){ %>
                <% const cityTimezone = weatherData.timezone || 0; %>
                <% const cityNow = new Date(((weatherData.dt || Date.now() / 1000) + cityTimezone) * 1000); %>
                <% const windSpeed = (weatherData.wind.speed * 3.6).toFixed(1); %>
                <% const visibilityKm = (weatherData.visibility / 1000).toFixed(1); %>
                <section class="current-weather" aria-labelledby="city-heading">
                    <div class="weather-copy">
                        <p class="eyebrow">CURRENT CONDITIONS</p>
                        <h1 id="city-heading"><%= weatherData.name %><% if(weatherData.sys.country){ %>, <%= weatherData.sys.country %><% } %></h1>
                        <p class="current-date"><%= cityNow.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }) %></p>
                        <div class="condition-line">
                            <img class="weather-icon" src="https://openweathermap.org/img/wn/<%= weatherData.weather[0].icon %>@2x.png" alt="">
                            <span><%= weatherData.weather[0].description %></span>
                        </div>
                    </div>
                    <div class="temperature-block">
                        <div class="unit-control" role="group" aria-label="Temperature units">
                            <button type="button" data-temperature-unit="c" aria-pressed="true">&#176;C</button>
                            <button type="button" data-temperature-unit="f" aria-pressed="false">&#176;F</button>
                        </div>
                        <p class="temperature" data-celsius="<%= weatherData.main.temp %>" data-fahrenheit="<%= weatherData.main.temp * 9 / 5 + 32 %>"><span class="temperature-value"><%= Math.round(weatherData.main.temp) %></span><span class="degree-symbol">&#176;</span><span class="temperature-unit">C</span></p>
                        <p class="temperature-note" data-celsius="<%= weatherData.main.feels_like %>" data-fahrenheit="<%= weatherData.main.feels_like * 9 / 5 + 32 %>">Feels like <%= Math.round(weatherData.main.feels_like) %>&#176;C</p>
                    </div>
                    <div class="temperature-range" aria-label="Today's temperature range">
                        <span>HIGH</span>
                        <strong class="range-value" data-celsius="<%= weatherData.main.temp_max %>" data-fahrenheit="<%= weatherData.main.temp_max * 9 / 5 + 32 %>"><%= Math.round(weatherData.main.temp_max) %>&#176;</strong>
                        <span class="range-divider"></span>
                        <span>LOW</span>
                        <strong class="range-value" data-celsius="<%= weatherData.main.temp_min %>" data-fahrenheit="<%= weatherData.main.temp_min * 9 / 5 + 32 %>"><%= Math.round(weatherData.main.temp_min) %>&#176;</strong>
                    </div>
                </section>

                <section class="conditions-section" aria-labelledby="conditions-heading">
                    <div class="section-heading">
                        <h2 id="conditions-heading">Weather details</h2>
                        <span>MEASURED NOW</span>
                    </div>
                    <div class="weather-box">
                        <article class="info-box">
                            <img src="images/humidity.png" alt="">
                            <div class="info"><p>Humidity</p><strong><%= weatherData.main.humidity %><span>%</span></strong></div>
                        </article>
                        <article class="info-box">
                            <img src="images/pressure.png" alt="">
                            <div class="info"><p>Pressure</p><strong><%= weatherData.main.pressure %><span> hPa</span></strong></div>
                        </article>
                        <article class="info-box">
                            <img src="images/wind.png" alt="">
                            <div class="info">
                                <div class="metric-label"><p>Wind speed</p>
                                    <span class="unit-control compact" role="group" aria-label="Wind speed units">
                                        <button type="button" data-wind-unit="kmh" aria-pressed="true">km/h</button>
                                        <button type="button" data-wind-unit="mph" aria-pressed="false">mph</button>
                                    </span>
                                </div>
                                <strong class="wind-value" data-kmh="<%= weatherData.wind.speed * 3.6 %>" data-mph="<%= weatherData.wind.speed * 2.236936 %>"><%= windSpeed %><span> km/h</span></strong>
                            </div>
                        </article>
                        <article class="info-box">
                            <svg class="visibility-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"></path><circle cx="12" cy="12" r="2.7"></circle></svg>
                            <div class="info"><p>Visibility</p><strong><%= visibilityKm %><span> km</span></strong></div>
                        </article>
                    </div>
                </section>

                <section class="forecast-section" aria-labelledby="forecast-heading">
                    <div class="section-heading">
                        <h2 id="forecast-heading">5-day forecast</h2>
                        <span>DAILY OUTLOOK</span>
                    </div>
                    <% if(locals.forecastDays && forecastDays.length){ %>
                        <div class="forecast-grid">
                            <% forecastDays.forEach((day) => { %>
                                <article class="forecast-day">
                                    <h3><%= day.date %></h3>
                                    <img src="https://openweathermap.org/img/wn/<%= day.icon %>@2x.png" alt="">
                                    <p><%= day.description %></p>
                                    <div><strong class="range-value" data-celsius="<%= day.high %>" data-fahrenheit="<%= day.high * 9 / 5 + 32 %>"><%= Math.round(day.high) %>&#176;</strong><span class="range-value" data-celsius="<%= day.low %>" data-fahrenheit="<%= day.low * 9 / 5 + 32 %>"><%= Math.round(day.low) %>&#176;</span></div>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="forecast-unavailable">The daily forecast is temporarily unavailable.</p>
                    <% } %>
                </section>

                <section class="sun-details" aria-label="Additional weather data">
                    <div class="data-item">
                        <span>Sunrise</span>
                        <strong><%= new Date((weatherData.sys.sunrise + cityTimezone) * 1000).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", timeZone: "UTC" }) %></strong>
                    </div>
                    <div class="data-item">
                        <span>Sunset</span>
                        <strong><%= new Date((weatherData.sys.sunset + cityTimezone) * 1000).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", timeZone: "UTC" }) %></strong>
                    </div>
                    <div class="data-item">
                        <span>Wind direction</span>
                        <strong><%= weatherData.wind.deg ?? "Unavailable" %><% if(weatherData.wind.deg != null){ %>&#176;<% } %></strong>
                    </div>
                    <div class="data-item">
                        <span>Sea level</span>
                        <strong><%= weatherData.main.sea_level ?? "Unavailable" %><% if(weatherData.main.sea_level != null){ %> hPa<% } %></strong>
                    </div>
                    <div class="data-item">
                        <span>Latitude</span>
                        <strong><%= weatherData.coord.lat %></strong>
                    </div>
                    <div class="data-item">
                        <span>Longitude</span>
                        <strong><%= weatherData.coord.lon %></strong>
                    </div>
                </section>
            <% } else if(locals.error){ %>
                <section class="empty-state" aria-live="polite">
                    <p class="eyebrow">WEATHERIA</p>
                    <h1>We couldn't find that forecast.</h1>
                    <p><%= error %></p>
                </section>
            <% } else { %>
                <section class="empty-state" aria-live="polite">
                    <p class="eyebrow">A CLEARER LOOK OUTSIDE</p>
                    <h1>Weather, wherever you are.</h1>
                    <p>Search for a city to see its current conditions and the details that matter.</p>
                </section>
            <% } %>
        </main>

        <footer class="site-footer">
            <span>Weatheria</span>
            <span>Current conditions, made clear.</span>
            <span>&copy; <%= new Date().getFullYear() %></span>
        </footer>
    </div>
    <script src="scripts/app.js" defer></script>
</body>
</html>